# Only the endpoint scripts in this directory are meant to be requested
# directly - config, shared library code, and the schema file are not.
<FilesMatch "^(config(\.sample)?\.php|schema\.sql|bootstrap\.php|composer\.(json|lock))$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Composer's vendor/ (PHP dependencies) is never meant to be requested
# directly either. It's gitignored and regenerated by `composer install`,
# so this is a rewrite rule here rather than a .htaccess placed inside it
# (which wouldn't survive a fresh install).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^vendor/ - [F,L]
</IfModule>

